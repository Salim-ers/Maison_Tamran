# --- Obligatoire -------------------------------------------------------------
# PostgreSQL (Neon, Supabase, Vercel Postgres, Railway…). Avec un pooler en mode transaction,
# ajoutez DATABASE_PREPARE=false.
DATABASE_URL=postgres://user:password@host:5432/tambre
# DATABASE_PREPARE=false
# DATABASE_POOL_MAX=5

# Secret de signature (sessions, liens de suivi de commande et de devis). 32 caractères minimum.
# Générer : openssl rand -base64 48
SESSION_SECRET=

# URL publique du site (liens dans les emails, Stripe, sitemap)
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr

# Compte administrateur créé par `npm run db:seed`
ADMIN_EMAIL=admin@exemple.fr
ADMIN_PASSWORD=

# --- Paiement Stripe ---------------------------------------------------------
# Sans STRIPE_SECRET_KEY, la boutique reste en MODE DÉMONSTRATION (paiements simulés,
# commandes marquées « démo », bandeau visible). Une clé sk_test_ permet de tester le vrai
# parcours Stripe sans débit ; sk_live_ encaisse réellement.
STRIPE_SECRET_KEY=
# Secret du point de terminaison webhook (https://<domaine>/api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=
# Forcer le mode démonstration même avec une clé Stripe : STORE_MODE=demo
# STORE_MODE=demo

# --- Emails transactionnels (Resend) -----------------------------------------
# Sans clé, les emails sont seulement journalisés (Admin › Emails), rien n'est envoyé.
RESEND_API_KEY=
EMAIL_FROM="TAMBRÉ <commandes@exemple.fr>"
# Destinataire des notifications internes (nouvelle commande, devis)
ADMIN_NOTIFY_EMAIL=
CONTACT_EMAIL=bonjour@exemple.fr

# --- Stockage des images (Vercel Blob) ---------------------------------------
# Requis en production pour téléverser des images (produits, logos des devis).
BLOB_READ_WRITE_TOKEN=

# --- Indexation ----------------------------------------------------------------
# En mode démonstration, robots.txt interdit l'indexation. Mettre true pour la forcer.
# ALLOW_INDEXING=true
